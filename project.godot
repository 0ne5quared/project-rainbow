; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[GDScript_Formatter]

format_on_save=true
line_length=80

[application]

config/name="project-rainbow"
run/main_scene="uid://djps884gv560c"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*uid://d0u2tuyhq6554"
ConnectionManager="*uid://ff071x27wtwy"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/missing_await=1

[display]

window/size/viewport_width=768
window/size/viewport_height=432
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/quality/msaa_2d=0

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gdscript_formatter/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg")

[gui]

theme/custom="uid://cjdriog5nm6e2"
theme/custom_font="uid://vl51qf47huaq"

